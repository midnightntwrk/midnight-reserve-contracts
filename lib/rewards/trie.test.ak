use aiken/builtin
use aiken/collection/list
use rewards/scale.{compact_encode}
use rewards/trie.{verify}
use rewards/trie_builder.{build, proof, root}

/// Same generator as the Rust `trievec` tool: a bare extrinsic
/// `Compact(len) || 0x04 || 0x0a || 0x00 || body`, body byte `j` of
/// extrinsic `i` = `(31 i + 7 j) mod 251`.
fn xt(i: Int, body_len: Int) -> ByteArray {
  let body =
    list.range(0, body_len - 1)
      |> list.foldr(
          "",
          fn(j, acc) {
            builtin.integer_to_bytearray(True, 1, ( 31 * i + 7 * j ) % 251)
              |> builtin.append_bytearray(acc)
          },
        )
  let inner = builtin.append_bytearray(#"040a00", body)
  compact_encode(builtin.length_of_bytearray(inner))
    |> builtin.append_bytearray(inner)
}

fn xts(n: Int, body_len: fn(Int) -> Int) -> List<ByteArray> {
  list.map(list.range(0, n - 1), fn(i) { xt(i, body_len(i)) })
}

const single_hashed = xts(1, fn(_) { 100 })

const three_inline = xts(3, fn(_) { 10 })

const five_mixed = [xt(0, 10), xt(1, 100), xt(2, 40), xt(3, 5), xt(4, 200)]

const seventeen = xts(17, fn(i) { 30 + i })

const seventy = xts(70, fn(i) { 20 + i % 40 })

