// -- verifier against the recorded nodes ---------------------------------------------

fn ok(
  root: ByteArray,
  xs: List<ByteArray>,
  i: Int,
  nodes: List<ByteArray>,
) -> Bool {
  expect Some(value) = list.at(xs, i)
  verify(root, compact_encode(i), nodes, value)
}

test verify_single_hashed() {
  ok(root_single_hashed, single_hashed, 0, nodes_single_hashed_0)
}

test verify_three_inline() {
  and {
    ok(root_three_inline, three_inline, 0, nodes_three_inline_0),
    ok(root_three_inline, three_inline, 2, nodes_three_inline_2),
  }
}

test verify_five_mixed() {
  and {
    ok(root_five_mixed, five_mixed, 1, nodes_five_mixed_1),
    ok(root_five_mixed, five_mixed, 3, nodes_five_mixed_3),
    ok(root_five_mixed, five_mixed, 4, nodes_five_mixed_4),
  }
}

test verify_seventeen() {
  and {
    ok(root_seventeen, seventeen, 0, nodes_seventeen_0),
    ok(root_seventeen, seventeen, 16, nodes_seventeen_16),
  }
}

test verify_seventy() {
  and {
    ok(root_seventy, seventy, 3, nodes_seventy_3),
    ok(root_seventy, seventy, 63, nodes_seventy_63),
    ok(root_seventy, seventy, 64, nodes_seventy_64),
    ok(root_seventy, seventy, 66, nodes_seventy_66),
  }
}

// -- builder reproduces sp_trie -----------------------------------------------------

test builder_roots() {
  and {
    root(build(single_hashed)) == root_single_hashed,
    root(build(three_inline)) == root_three_inline,
    root(build(five_mixed)) == root_five_mixed,
    root(build(seventeen)) == root_seventeen,
    root(build(seventy)) == root_seventy,
  }
}

test builder_proofs() {
  let t5 = build(five_mixed)
  let t70 = build(seventy)
  and {
    proof(build(single_hashed), 0) == nodes_single_hashed_0,
    proof(build(three_inline), 2) == nodes_three_inline_2,
    proof(t5, 1) == nodes_five_mixed_1,
    proof(t5, 3) == nodes_five_mixed_3,
    proof(t5, 4) == nodes_five_mixed_4,
    proof(build(seventeen), 16) == nodes_seventeen_16,
    proof(t70, 3) == nodes_seventy_3,
    proof(t70, 64) == nodes_seventy_64,
    proof(t70, 66) == nodes_seventy_66,
  }
}

test builder_every_index_verifies() {
  let t = build(seventy)
  let r = root(t)
  list.all(
    list.range(0, 69),
    fn(i) {
      expect Some(value) = list.at(seventy, i)
      verify(r, compact_encode(i), proof(t, i), value)
    },
  )
}

// -- failures ------------------------------------------------------------------------

test verify_wrong_value() fail {
  verify(
    root_single_hashed,
    compact_encode(0),
    nodes_single_hashed_0,
    xt(0, 99),
  )
}

test verify_wrong_index() fail {
  ok(root_five_mixed, five_mixed, 2, nodes_five_mixed_1)
}

test verify_value_under_other_key() fail {
  expect Some(value) = list.at(five_mixed, 1)
  verify(root_five_mixed, compact_encode(3), nodes_five_mixed_1, value)
}

test verify_wrong_root() fail {
  ok(root_seventeen, five_mixed, 1, nodes_five_mixed_1)
}

test verify_missing_node() fail {
  ok(root_five_mixed, five_mixed, 1, list.take(nodes_five_mixed_1, 2))
}

test verify_extra_node() fail {
  ok(
    root_five_mixed,
    five_mixed,
    3,
    list.concat(nodes_five_mixed_3, nodes_five_mixed_1),
  )
}

test verify_tampered_node() fail {
  expect [first, ..rest] = nodes_five_mixed_1
  let tampered = builtin.append_bytearray(first, #"00")
  ok(root_five_mixed, five_mixed, 1, [tampered, ..rest])
}

test verify_index_out_of_range() fail {
  let t = build(five_mixed)
  verify(root(t), compact_encode(5), proof(t, 4), xt(5, 3))
}
