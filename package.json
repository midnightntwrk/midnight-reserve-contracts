{
  "name": "offchain",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf ./dist",
    "check": "tsc --noEmit",
    "lint": "eslint 'cli-yargs/**/*.ts' 'tests/**/*.ts' --ignore-pattern '**/dist/**'",
    "lint:fix": "bun lint --fix",
    "fmt": "prettier --write 'cli-yargs/**/*.ts' 'tests/**/*.ts'",
    "fmt:check": "prettier --check 'cli-yargs/**/*.ts' 'tests/**/*.ts'",
    "cli": "bun run cli-yargs/index.ts",
    "cli:deploy": "bun run cli-yargs/index.ts deploy",
    "cli:deploy:local": "bun run cli-yargs/index.ts deploy -n local",
    "cli:deploy:preview": "bun run cli-yargs/index.ts deploy -n preview",
    "cli:deploy:preprod": "bun run cli-yargs/index.ts deploy -n preprod",
    "cli:info": "bun run cli-yargs/index.ts info",
    "cli:info:preview": "bun run cli-yargs/index.ts info -n preview",
    "cli:simple-tx": "bun run cli-yargs/index.ts simple-tx"
  },
  "devDependencies": {
    "@blaze-cardano/blueprint": "0.9.0",
    "@blaze-cardano/data": "0.6.8",
    "@blaze-cardano/emulator": "0.5.2",
    "@blaze-cardano/query": "0.6.2",
    "@blaze-cardano/sdk": "0.3.1",
    "@blaze-cardano/uplc": "0.5.1",
    "@blaze-cardano/vm": "0.3.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@types/bun": "^1.4.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "cbor": "^10.0.12",
    "eslint": "10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@types/yargs": "^17.0.35",
    "toml": "^5.0.0",
    "yargs": "^18.2.0"
  }
}
